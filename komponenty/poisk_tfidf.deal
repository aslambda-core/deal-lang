{
 "файл": "поиск_tfidf",
 "происхождение": "мини-RAG: вес слова = tf * ln(всего_доков / доков_с_словом)",
 "сделки": [
  {
   "имя": "вес_слова",
   "входы": [
    {
     "имя": "частота_в_доке",
     "тип": "число"
    },
    {
     "имя": "всего_слов_в_доке",
     "тип": "число"
    },
    {
     "имя": "доков_с_словом",
     "тип": "число"
    },
    {
     "имя": "всего_доков",
     "тип": "число"
    }
   ],
   "выход": "число",
   "отказы": [
    "деление_на_ноль"
   ],
   "требует": {
    "оп": "и",
    "лево": {
     "оп": "сравнение",
     "чем": ">",
     "лево": {
      "оп": "поле",
      "имя": "всего_слов_в_доке"
     },
     "право": {
      "оп": "константа",
      "значение": 0
     }
    },
    "право": {
     "оп": "и",
     "лево": {
      "оп": "сравнение",
      "чем": ">",
      "лево": {
       "оп": "поле",
       "имя": "доков_с_словом"
      },
      "право": {
       "оп": "константа",
       "значение": 0
      }
     },
     "право": {
      "оп": "сравнение",
      "чем": ">",
      "лево": {
       "оп": "поле",
       "имя": "всего_доков"
      },
      "право": {
       "оп": "константа",
       "значение": 0
      }
     }
    }
   },
   "тело": [
    {
     "оп": "присваивание",
     "имя": "tf",
     "что": {
      "оп": "арифметика",
      "чем": "/",
      "лево": {
       "оп": "поле",
       "имя": "частота_в_доке"
      },
      "право": {
       "оп": "поле",
       "имя": "всего_слов_в_доке"
      }
     }
    },
    {
     "оп": "присваивание",
     "имя": "idf",
     "что": {
      "оп": "зов",
      "договор": "логарифм",
      "аргументы": [
       {
        "оп": "арифметика",
        "чем": "/",
        "лево": {
         "оп": "поле",
         "имя": "всего_доков"
        },
        "право": {
         "оп": "поле",
         "имя": "доков_с_словом"
        }
       }
      ]
     }
    },
    {
     "оп": "верни",
     "что": {
      "оп": "арифметика",
      "чем": "*",
      "лево": {
       "оп": "поле",
       "имя": "tf"
      },
      "право": {
       "оп": "поле",
       "имя": "idf"
      }
     }
    }
   ],
   "свидетель": [
    {
     "вход": {
      "частота_в_доке": 4,
      "всего_слов_в_доке": 100,
      "доков_с_словом": 10,
      "всего_доков": 100
     },
     "выход": 0.09210340371976183
    },
    {
     "вход": {
      "частота_в_доке": 10,
      "всего_слов_в_доке": 100,
      "доков_с_словом": 100,
      "всего_доков": 100
     },
     "выход": 0.0
    },
    {
     "вход": {
      "частота_в_доке": 1,
      "всего_слов_в_доке": 50,
      "доков_с_словом": 1,
      "всего_доков": 100
     },
     "выход": 0.09210340371976183
    }
   ]
  }
 ]
}